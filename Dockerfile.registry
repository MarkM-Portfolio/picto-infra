FROM registry:2.8.3

WORKDIR ${CONTAINER_REGISTRY_PVC}

ARG CONTAINER_REGISTRY_PVC
ENV CONTAINER_REGISTRY_PVC=${CONTAINER_REGISTRY_PVC}

ARG CONTAINER_REGISTRY_DELETE_ENABLED
ENV CONTAINER_REGISTRY_DELETE_ENABLED=${CONTAINER_REGISTRY_DELETE_ENABLED}

ARG CONTAINER_REGISTRY_PORT
ENV CONTAINER_REGISTRY_PORT=${CONTAINER_REGISTRY_PORT}

COPY ./registry/config.template .

RUN sed -e "s|\${CONTAINER_REGISTRY_PVC}|${CONTAINER_REGISTRY_PVC}|g" \
        -e "s|\${CONTAINER_REGISTRY_DELETE_ENABLED}|${CONTAINER_REGISTRY_DELETE_ENABLED}|g" \
        -e "s|\${CONTAINER_REGISTRY_PORT}|${CONTAINER_REGISTRY_PORT}|g" \
    "config.template" > "config.yml" \
    && echo "✅ Config generated!"

EXPOSE ${CONTAINER_REGISTRY_PORT}

CMD [ "registry", "serve", "config.yml" ]

# HEALTHCHECK CMD wget --spider -q http://localhost:${CONTAINER_REGISTRY_PORT}/v2/_catalog || exit 1
